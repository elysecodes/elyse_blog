# Copy this file to .env and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#
# The anon (publishable) key is safe to expose in the browser **as long as**
# the Row-Level Security policies in db/schema.sql have been applied.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the build base path (defaults to /elyse_blog/ on build)
# VITE_BASE=/elyse_blog/
